# Copy to backend/.env (gitignored) and fill in real values.
# NEVER commit the real .env — it holds live secrets.

# Supabase — the isolated "archlens-ai" project, NOT Kith's existing project.
# Project: https://supabase.com/dashboard/project/litwegklwcfbwjnemaaq
SUPABASE_URL=https://litwegklwcfbwjnemaaq.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# Anthropic — issue this under its own Anthropic Console project, not Kith's
# existing key, so ArchLens spend/usage stays separately trackable.
ANTHROPIC_API_KEY=
ARCHLENS_ANTHROPIC_MODEL=claude-haiku-4-5

# Razorpay — billing runs through Kith's existing Razorpay account (NOT a
# separate ArchLens merchant account). International card payments (needed
# for USD billing) were requested 2026-09-16 and are pending Razorpay's own
# review — see CLAUDE.md item 38 for status before assuming USD plans can
# be created. Key ID/secret
# come from Account & Settings > API Keys in that dashboard; the webhook
# secret is set when configuring the webhook URL under Account & Settings >
# Webhooks (subscribe to: subscription.activated, subscription.charged,
# subscription.halted, subscription.cancelled, subscription.paused,
# subscription.resumed). Plan IDs come from creating two Plans (Solo $12/mo,
# Team $29/mo, both USD) via the dashboard or the Plans API.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PLAN_SOLO=
RAZORPAY_PLAN_TEAM=

# Render step — point at a real Chromium binary if the default isn't found.
PUPPETEER_EXECUTABLE_PATH=
